{
  "name": "Short Copy - URL Shortener & Copy Link",
  "version": "1.2.1",
  "description": "Shorten URLs and copy links in one step. Use Alt+Shift+C or click the toolbar icon. Free, with no account required.",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "notifications",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "16.png",
    "32": "32.png",
    "48": "48.png",
    "128": "128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      }
    },
    "toggle-pin": {
      "description": "Shorten and copy the current URL (legacy shortcut)"
    }
  },
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "host_permissions": [
    "https://is.gd/*"
  ],
  "action": {
    "default_title": "Shorten and copy this URL",
    "default_icon": {
      "16": "16.png",
      "32": "32.png",
      "48": "48.png",
      "128": "128.png"
    }
  },
  "short_name": "Short Copy"
}
